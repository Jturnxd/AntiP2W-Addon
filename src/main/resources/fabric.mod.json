{
  "schemaVersion": 1,
  "id": "antip2w",
  "version": "${version}",
  "name": "AntiP2W Tools",
  "description": "Tools to fight against pay-to-win servers",
  "authors": [
    "DuckGuy",
    "Exteron",
    "0x06"
  ],
  "contact": {
    "homepage": "https://github.com/AntiP2WDevelopment/AntiP2W-Addon/",
    "issues": "https://github.com/AntiP2WDevelopment/AntiP2W-Addon/issues",
    "repo": "https://github.com/AntiP2WDevelopment/AntiP2W-Addon/",
    "sources": "https://github.com/AntiP2WDevelopment/AntiP2W-Addon/"
  },
  "license": "CC-BY-NC-SA-4.0",
  "icon": "assets/antip2w/icon/64x64.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "antip2w.tools.AntiP2WTools"
    ]
  },
  "mixins": [
    "antip2w.mixins.json"
  ],
  "custom": {
    "commit-hash": "${commit_hash}",
    "build-time": "${build_time}",
    "meteor-client:color": "225,55,55",
    "modmenu": {
      "links": {
        "modmenu.github_releases": "https://github.com/AntiP2WDevelopment/AntiP2W-Addon/actions"
      }
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${minecraft_version}"],
    "fabric-api": "*",
    "meteor-client": "*"
  },
  "accessWidener": "antip2w.accesswidener"
}
